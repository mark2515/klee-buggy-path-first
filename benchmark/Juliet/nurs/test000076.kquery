array a[4] : w32 -> w8 = symbolic
array a_1[4] : w32 -> w8 = symbolic
array b_1[4] : w32 -> w8 = symbolic
array c_1[4] : w32 -> w8 = symbolic
array d[4] : w32 -> w8 = symbolic
array d_1[4] : w32 -> w8 = symbolic
(query [(Eq false
             (Sle 0
                  (ReadLSB w32 0 a)))
         (Sle 0
              N0:(ReadLSB w32 0 d))
         (Eq false (Slt N0 4))
         (Slt 4294967276
              N1:(ReadLSB w32 0 a_1))
         (Slt N1 20)
         (Eq false
             (Eq 1234
                 (Xor w32 N2:(ReadLSB w32 0 b_1)
                          N3:(ReadLSB w32 0 c_1))))
         (Eq 999
             (Sub w32 (Add w32 N1 N2) N3))
         (Eq false (Slt 5 N1))
         (Sle 0 N1)
         (Slt 2 N2)
         (Slt N3 0)
         (Eq false
             (Sle 0
                  (Add w32 999
                           (ReadLSB w32 0 d_1))))]
        false)
