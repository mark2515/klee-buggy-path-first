array a[4] : w32 -> w8 = symbolic
array a_1[4] : w32 -> w8 = symbolic
array b_1[4] : w32 -> w8 = symbolic
array c_1[4] : w32 -> w8 = symbolic
array d[4] : w32 -> w8 = symbolic
array d_1[4] : w32 -> w8 = symbolic
(query [(Eq false
             (Sle 0
                  (ReadLSB w32 0 a)))
         (Eq false
