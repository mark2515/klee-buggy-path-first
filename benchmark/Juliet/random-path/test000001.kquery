array a[4] : w32 -> w8 = symbolic
array b[4] : w32 -> w8 = symbolic
array c[4] : w32 -> w8 = symbolic
array d[4] : w32 -> w8 = symbolic
(query [(Sle 0
              N0:(ReadLSB w32 0 a))
         (Slt N0 6)
         (Sle 0
              N1:(Add w32 (Sub w32 (Add w32 N0
                                            (ReadLSB w32 0 b))
                                   (ReadLSB w32 0 c))
                          (ReadLSB w32 0 d)))
         (Slt N1 6)]
        false)
